# FChat environment variables. ALL of them are optional.
# With the Vercel button you do not need to set any: secrets are generated on their own,
# the administrator account is created on the setup screen and the Meta app details
# are pasted in the dashboard, under "Connect your accounts".
#
# On your computer: copy this file to .env.local and set at least PGLITE_DIR.
# On Vercel: Settings › Environment Variables. Never push a file with real values to GitHub.

# --- Database ---
# On Vercel, the Neon database sets it for you.
DATABASE_URL=
# Only on your computer, if you do not have Postgres: folder for the local PGlite database.
# ABSOLUTE path outside the project folder, for example C:/fchat-data or /home/you/fchat-data
PGLITE_DIR=

# --- Public address ---
# Not needed on Vercel: it is taken from the production domain.
# Set it if you use a custom domain or a tunnel on your computer. No trailing slash.
PUBLIC_URL=

# --- Administrator account ---
# Without these two, the account is created on the setup screen.
# They are useful to recover access: on startup, FChat sets this password and signs out
# every session. While they are set, the password can only be changed here.
# At least 12 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Your Meta app ---
# Without these two, you paste them in the dashboard. If they are set, they take priority.
# Meta dashboard › your app › API setup with Instagram login
# "Instagram app ID":
IG_APP_ID=
# "Instagram app secret": used to verify that notifications really come from Meta.
IG_APP_SECRET=
# What you paste in Meta as "Verify token". Without it, FChat generates one and shows it in the guide.
WEBHOOK_VERIFY_TOKEN=
IG_API_VERSION=v26.0

# Instagram token generated in the Meta dashboard, to connect your account without the
# "Connect Instagram" button. It is imported on startup and then the app renews it on its own.
IG_ACCESS_TOKEN=

# --- Secrets ---
# Without them, FChat generates each one the first time and stores it in the database.
# Signs dashboard sessions:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Encrypts Instagram access and your app secret: 32 bytes in base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If you set or change it after connecting Instagram, you need to connect it again.
TOKEN_ENC_KEY=
# Protects /api/cron, the daily task that renews Instagram access. Without it, the route
# is public but runs at most once every 10 minutes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
