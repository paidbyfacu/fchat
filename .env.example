# FChat: variables de entorno.
# En tu PC: copia este archivo como .env.local y complétalo. En Vercel: cárgalas en
# Settings › Environment Variables. Nunca subas a GitHub un archivo con valores reales.

# --- Base de datos ---
# En Vercel la pone sola la base de Neon que conectas desde Storage.
DATABASE_URL=
# Solo en tu PC, si no tienes Postgres: carpeta para la base local PGlite.
# Ruta ABSOLUTA y fuera de la carpeta del proyecto, por ejemplo C:/fchat-data o /home/tu/fchat-data
PGLITE_DIR=

# --- Dirección pública ---
# En Vercel no hace falta: se toma sola del dominio de producción.
# Defínela si usas un dominio propio o un túnel en tu PC. Sin barra al final.
PUBLIC_URL=

# --- Secretos propios: genéralos una vez y no los compartas ---
# Firma las sesiones del panel. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Cifra los accesos a Instagram en la base. Tienen que ser 32 bytes en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si lo cambias después, hay que volver a conectar Instagram.
TOKEN_ENC_KEY=
# Protege /api/cron, la tarea diaria que renueva el acceso a Instagram:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# --- Tu usuario del panel ---
# Se crea al arrancar. Si cambias la contraseña acá, se cierran todas las sesiones abiertas.
# En producción la contraseña tiene que tener al menos 12 caracteres. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Tu app de Meta ---
# Panel de Meta › tu app › Instagram › Configuración de la API con inicio de sesión con Instagram
# "Identificador de la app de Instagram":
IG_APP_ID=
# "Clave secreta de la app de Instagram": con ella se verifica que los avisos vengan de Meta.
IG_APP_SECRET=
# Un texto al azar que inventas y pegas también en el panel de Meta, en "Token de verificación":
WEBHOOK_VERIFY_TOKEN=
IG_API_VERSION=v26.0

# Opcional: token de Instagram generado en el panel de Meta, para conectar tu cuenta sin el botón
# "Conectar Instagram". Se importa al arrancar y después la app lo renueva sola.
IG_ACCESS_TOKEN=
