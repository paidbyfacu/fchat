# FChat: variables de entorno. TODAS son opcionales.
# Con el botón de Vercel no hace falta cargar ninguna: los secretos se generan solos,
# la cuenta de administrador se crea en la pantalla de instalación y la app de Meta
# se pega en el panel, en Vincula tus redes.
#
# En tu computadora: copia este archivo como .env.local y completa al menos PGLITE_DIR.
# En Vercel: Settings › Environment Variables. Nunca subas a GitHub un archivo con valores reales.

# --- Base de datos ---
# En Vercel la pone sola la base de Neon.
DATABASE_URL=
# Solo en tu computadora, si no tienes Postgres: carpeta para la base local PGlite.
# Ruta ABSOLUTA y fuera de la carpeta del proyecto, por ejemplo C:/fchat-data o /home/tu/fchat-data
PGLITE_DIR=

# --- Dirección pública ---
# En Vercel no hace falta: se toma sola del dominio de producción.
# Defínela si usas un dominio propio o un túnel en tu computadora. Sin barra al final.
PUBLIC_URL=

# --- Cuenta de administrador ---
# Sin estas dos, la cuenta se crea en la pantalla de instalación.
# Sirven para recuperar el acceso: al arrancar, FChat pone esta contraseña y cierra
# todas las sesiones. Mientras estén cargadas, la contraseña solo se cambia desde acá.
# Mínimo 12 caracteres. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Tu app de Meta ---
# Sin estas dos, se pegan en el panel, en Vincula tus redes. Si están, tienen prioridad.
# Panel de Meta › tu app › Configuración de la API con inicio de sesión con Instagram
# "Identificador de la app de Instagram":
IG_APP_ID=
# "Clave secreta de la app de Instagram": con ella se verifica que los avisos vengan de Meta.
IG_APP_SECRET=
# Lo que se pega en Meta en "Token de verificación". Sin ella, FChat genera uno y lo muestra en la guía.
WEBHOOK_VERIFY_TOKEN=
IG_API_VERSION=v26.0

# Token de Instagram generado en el panel de Meta, para conectar tu cuenta sin el botón
# "Conectar Instagram". Se importa al arrancar y después la app lo renueva sola.
IG_ACCESS_TOKEN=

# --- Secretos ---
# Sin ellos, FChat genera cada uno la primera vez y lo guarda en la base.
# Firma las sesiones del panel:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Cifra los accesos a Instagram y la clave de tu app: 32 bytes en base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la cargas o la cambias después de conectar Instagram, hay que volver a conectarlo.
TOKEN_ENC_KEY=
# Protege /api/cron, la tarea diaria que renueva el acceso a Instagram. Sin ella, la ruta
# es pública pero corre como mucho una vez cada 10 minutos.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
